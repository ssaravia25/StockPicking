# Trading Matrix - Environment Variables
# Copy this file to .env and fill in your values

# ===== Gmail Configuration =====
# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
# You need 2FA enabled on your Google account to create an App Password
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated list of email recipients
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ===== Google Sheets Configuration =====
# Base64-encoded service account JSON credentials
# To generate:
# 1. Go to Google Cloud Console > IAM & Admin > Service Accounts
# 2. Create a service account with Google Sheets API access
# 3. Download the JSON key file
# 4. Encode it: base64 -i service-account.json | tr -d '\n'
GOOGLE_SHEETS_CREDENTIALS=base64-encoded-json-here

# Name of the Google Spreadsheet to create/update
SPREADSHEET_NAME=Trading_Matrix_PremiumSS_Momentum26

# ===== Optional: Custom Tickers =====
# If set, will analyze these tickers instead of S&P 500
# Comma-separated list of ticker symbols
# CUSTOM_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA

# ===== Flask Configuration =====
# Set to "true" for development mode
FLASK_DEBUG=false

# Port for the Flask server (default: 8080)
PORT=8080
